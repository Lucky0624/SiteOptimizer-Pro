# Import the Google service account JSON file in Settings. These empty variables are optional deployment fallbacks.
ADMIN_KEY=your-admin-key-here
DEBUG=false
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SITE_URL=https://your-site.com/
# Required only outside Windows. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=sqlite+aiosqlite:///./siteoptimizer.db
GSC_DAILY_LIMIT=100000
INSPECTION_DAILY_LIMIT=2000
INDEXING_DAILY_LIMIT=200
GOOGLE_PSI_API_KEY=
GA4_PROPERTY_ID=
DINGTALK_WEBHOOK_URL=
WECOM_WEBHOOK_URL=
LCP_THRESHOLD_MS=2500.0
